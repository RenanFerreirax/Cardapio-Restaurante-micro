# Copia este ficheiro para ".env" e ajusta os valores.
# O ".env" está no .gitignore (não vai para o Git), por isso cada
# máquina (a tua de casa e o servidor da faculdade) tem o seu próprio.

# ----------------------------------------------------------------
# BASE DE DADOS
# ----------------------------------------------------------------
# EM CASA (SQLite - default deste projeto):
DATABASE_URL="file:./dev.db"

# NA FACULDADE (MySQL) - troca a linha acima por esta e ajusta os dados:
# DATABASE_URL="mysql://utilizador:senha@host:3306/nome_da_base"
# Lembra-te também de trocar o "provider" no prisma/schema.prisma de
# "sqlite" para "mysql" (instruções já estão comentadas lá no ficheiro).

# ----------------------------------------------------------------
# SERVIDOR
# ----------------------------------------------------------------
PORT=3000

# ----------------------------------------------------------------
# RABBITMQ
# ----------------------------------------------------------------
# EM CASA (RabbitMQ local, ex: via Docker):
RABBITMQ_URL="amqp://localhost"

# NA FACULDADE, troca pela URL fornecida pelo professor, ex:
# RABBITMQ_URL="amqp://utilizador:senha@host:5672"
